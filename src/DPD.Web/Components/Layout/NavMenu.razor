@using System.Security.Claims
﻿@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DPD Operations</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler')?.click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="projects">Project and Study</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="timesheets">Time Tracking</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="equipment">Equipment and Maintenance</NavLink>
        </div>
    </nav>

    <div class="px-3 mt-4">
        <p class="text-white-50 mb-1">Mock role: <strong class="text-white">@CurrentRole</strong></p>
        <div class="d-flex flex-wrap gap-1">
            @foreach (var role in Roles)
            {
                <button type="button"
                        class="btn btn-sm @(role == CurrentRole ? "btn-primary" : "btn-outline-light")"
                        @onclick="() => SwitchRole(role)">@role</button>
            }
        </div>
    </div>
</div>

@code {
    private static readonly string[] Roles =
        ["Scientist", "Manager", "SD", "PrincipalInvestigator", "EquipmentOwner", "DepartmentResponsible", "Admin", "StandardUser", "ReadOnly"];

    private string CurrentRole =>
        HttpContextAccessor.HttpContext?.User?.FindFirst(ClaimTypes.Role)?.Value ?? "Scientist";

    private void SwitchRole(string role)
    {
        // forceLoad: true déclenche une vraie requête HTTP GET (et non une navigation SPA interceptée
        // par l'enhanced navigation de Blazor), garantissant que le endpoint mock/set-role s'exécute,
        // pose les cookies de rôle, puis recharge entièrement la page avec les nouvelles claims signées.
        NavigationManager.NavigateTo($"mock/set-role/{role}", forceLoad: true);
    }
}
