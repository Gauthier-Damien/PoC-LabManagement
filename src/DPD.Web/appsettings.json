{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=dpd-poc.db"
  },
  "Authentication": {
    "Mode": "Mock",
    "Entra": {
      "Authority": "https://login.microsoftonline.com/common/v2.0",
      "ClientId": "replace-me",
      "ClientSecret": "replace-me",
      "ResponseType": "code",
      "CallbackPath": "/signin-oidc"
    }
  },
  "FeatureFlags": {
    "EnableReporting": true,
    "EnableMaintenance": true,
    "EnableCapacityPlanning": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dpd-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
