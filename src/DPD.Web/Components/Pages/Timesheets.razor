@page "/timesheets"
@using DPD.Web.Common
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<Timesheets> Logger

<PageTitle>Timesheets</PageTitle>

<h1>Time Tracking</h1>

<p>Submit timesheet entries and approve submitted entries based on RBAC policies.</p>

<div class="row g-3">
    <div class="col-md-6">
        <EditForm Model="submitVm" OnValidSubmit="SubmitAsync">
            <MudSelect T="Guid" Label="Resource" @bind-Value="submitVm.ResourceId">
                @foreach (var item in resources)
                {
                    <MudSelectItem Value="item.Id">@item.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid" Label="Study" @bind-Value="submitVm.StudyId">
                @foreach (var item in studies)
                {
                    <MudSelectItem Value="item.Id">@item.Name</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker Label="Work Date" DateChanged="OnDateChanged" Date="workDate" />
            <MudNumericField T="decimal" @bind-Value="submitVm.Hours" Label="Hours" Min="0.5m" Max="24m" />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit">Submit</MudButton>
        </EditForm>
    </div>
</div>

<MudDivider Class="my-3" />

<MudTable Items="entries" Dense="true" Hover="true">
    <HeaderContent>
        <MudTh>Work Date</MudTh>
        <MudTh>Hours</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Commentaire de rejet</MudTh>
        <MudTh>Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.WorkDate</MudTd>
        <MudTd>@context.Hours</MudTd>
        <MudTd>@context.Status</MudTd>
        <MudTd>@context.RejectionComment</MudTd>
        <MudTd>
            @if (context.Status == "Submitted")
            {
                <MudButton Size="Size.Small" Color="Color.Success" OnClick="() => ApproveAsync(context.Id)">Approve</MudButton>
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => OpenRejectDialog(context.Id)">Reject</MudButton>
            }
            @if (context.Status == "Approved")
            {
                <MudButton Size="Size.Small" OnClick="() => LockAsync(context.Id)">Lock</MudButton>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@if (rejectingEntryId is not null)
{
    <MudPaper Class="pa-4 mt-3" Elevation="2">
        <p>Motif de rejet (obligatoire) pour la saisie sélectionnée :</p>
        <MudTextField @bind-Value="rejectionComment" Label="Commentaire" Lines="2" Required="true" />
        <div class="d-flex gap-2 mt-2">
            <MudButton Color="Color.Error" OnClick="ConfirmRejectAsync">Confirmer le rejet</MudButton>
            <MudButton OnClick="CancelReject">Annuler</MudButton>
        </div>
    </MudPaper>
}

@code {
    private readonly SubmitVm submitVm = new();
    private DateTime? workDate = DateTime.UtcNow.Date;
    private List<IdNameVm> resources = [];
    private List<IdNameVm> studies = [];
    private List<TimeEntryVm> entries = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        resources = await Http.GetFromJsonAsync<List<IdNameVm>>("api/reference/resources") ?? [];
        studies = await Http.GetFromJsonAsync<List<IdNameVm>>("api/reference/studies") ?? [];

        if (resources.Count > 0 && submitVm.ResourceId == Guid.Empty) submitVm.ResourceId = resources[0].Id;
        if (studies.Count > 0 && submitVm.StudyId == Guid.Empty) submitVm.StudyId = studies[0].Id;

        entries = await Http.GetFromJsonAsync<List<TimeEntryVm>>("api/timesheets?page=1&pageSize=100") ?? [];
    }

    private void OnDateChanged(DateTime? date)
    {
        workDate = date;
        submitVm.WorkDate = DateOnly.FromDateTime((date ?? DateTime.UtcNow).Date);
    }

    private async Task SubmitAsync()
    {
        try
        {
            submitVm.WorkDate = DateOnly.FromDateTime((workDate ?? DateTime.UtcNow).Date);
            var response = await Http.PostAsJsonAsync("api/timesheets", submitVm);
            await response.EnsureSuccessOrThrowAsync(Logger, "soumission d'une saisie de temps");
            submitVm.Hours = 0;
            await LoadAsync();
            Snackbar.Add("Saisie de temps soumise.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Échec de la soumission de la saisie de temps");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ApproveAsync(Guid timeEntryId)
    {
        try
        {
            var approverId = resources.FirstOrDefault()?.Id ?? Guid.Empty;
            var response = await Http.PatchAsJsonAsync($"api/timesheets/{timeEntryId}/approve", new { approverId });
            await response.EnsureSuccessOrThrowAsync(Logger, "approbation d'une saisie de temps");
            await LoadAsync();
            Snackbar.Add("Saisie de temps approuvée.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Échec de l'approbation de la saisie de temps");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OpenRejectDialog(Guid timeEntryId)
    {
        rejectingEntryId = timeEntryId;
        rejectionComment = string.Empty;
    }

    private void CancelReject()
    {
        rejectingEntryId = null;
        rejectionComment = string.Empty;
    }

    private async Task ConfirmRejectAsync()
    {
        if (rejectingEntryId is not { } timeEntryId)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(rejectionComment))
        {
            Snackbar.Add("Un commentaire est obligatoire pour rejeter une feuille de temps.", Severity.Warning);
            return;
        }

        try
        {
            var approverId = resources.FirstOrDefault()?.Id ?? Guid.Empty;
            var response = await Http.PatchAsJsonAsync($"api/timesheets/{timeEntryId}/reject", new { approverId, comment = rejectionComment });
            await response.EnsureSuccessOrThrowAsync(Logger, "rejet d'une saisie de temps");
            CancelReject();
            await LoadAsync();
            Snackbar.Add("Saisie de temps rejetée.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Échec du rejet de la saisie de temps");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LockAsync(Guid timeEntryId)
    {
        try
        {
            var response = await Http.PatchAsync($"api/timesheets/{timeEntryId}/lock", null);
            await response.EnsureSuccessOrThrowAsync(Logger, "verrouillage d'une saisie de temps");
            await LoadAsync();
            Snackbar.Add("Saisie de temps verrouillée.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Échec du verrouillage de la saisie de temps (réservé aux administrateurs)");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private sealed class SubmitVm
    {
        public Guid ResourceId { get; set; }
        public Guid StudyId { get; set; }
        public DateOnly WorkDate { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow.Date);
        public decimal Hours { get; set; }
    }

    private Guid? rejectingEntryId;
    private string rejectionComment = string.Empty;

    private sealed record TimeEntryVm(Guid Id, Guid ResourceId, Guid StudyId, DateOnly WorkDate, decimal Hours, string Status, string? RejectionComment);
    private sealed record IdNameVm(Guid Id, string Name);
}
